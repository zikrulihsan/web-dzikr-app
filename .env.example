# Copy to .env.local and fill in what you need. Every variable is optional:
# without them the app runs fully offline (progress stays on the device).

# Supabase — enables the leaderboard and community presence.
# Dashboard → Project Settings → API. Run supabase/schema.sql first.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Analytics — each one loads only when set.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
NEXT_PUBLIC_UMAMI_SCRIPT_URL=
NEXT_PUBLIC_UMAMI_DOMAINS=
