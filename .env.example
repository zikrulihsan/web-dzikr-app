# Copy to .env.local and fill in, then restart `npm run dev`.
#
# IMPORTANT for deploys: NEXT_PUBLIC_* values are inlined into the bundle at
# BUILD time, not read at runtime. Adding them in the Netlify UI does nothing
# until you trigger a new deploy.

# --- Supabase (required for the live features) --------------------------------
# Dashboard → Project Settings → API. Without these two the app still runs, but
# presence, the community page and the leaderboard are all disabled.
#
# Also required, one time per project:
#   1. Run supabase/schema.sql in the SQL editor.
#   2. Enable Authentication → Sign In / Providers → Anonymous sign-ins (OFF by default).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# --- Analytics (optional) -----------------------------------------------------
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_UMAMI_SCRIPT_URL=
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
